# Local development secrets for docker-compose.yml. Copy to .env.docker and CHANGE every value.
# Generate random values with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me-postgres
MEMIA_OWNER_PASSWORD=change-me-owner
MEMIA_APP_PASSWORD=change-me-app
# API/MCP bearer token for the seeded "default" tenant (stored in DB only as SHA-256)
MEMIA_DEV_TOKEN=change-me-dev-token-0123456789abcdef
# REQUIRED, >= 32 bytes hex: openssl rand -hex 32  (signs the acting user between chat and core)
DEVBRAIN_ACTOR_HMAC_KEY=
# Admin panel (/admin) and chat login passwords, min 12 chars
MEMIA_ADMIN_PASSWORD=change-me-admin-pass
CHAT_DEV_PASSWORD=change-me-chat-pass
# Optional AI providers (leave empty for memory-only / full-text mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEVBRAIN_OLLAMA_URL=
