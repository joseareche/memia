# Memia chat front-end (chat/) — development image.
FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY chat/ .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/memia-chat .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/memia-chat /usr/local/bin/memia-chat
COPY deploy/docker/chat-entrypoint.sh /usr/local/bin/chat-entrypoint.sh
RUN useradd -r -u 10002 memia && mkdir -p /var/lib/memia-chat && chown memia /var/lib/memia-chat \
    && chmod +x /usr/local/bin/chat-entrypoint.sh
USER memia
EXPOSE 8093
ENTRYPOINT ["/usr/local/bin/chat-entrypoint.sh"]
