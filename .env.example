# Memia core (app/)
DEVBRAIN_LISTEN=127.0.0.1:8080
DEVBRAIN_DSN=host=/var/run/postgresql dbname=devbrain user=devbrain_app
DEVBRAIN_ADMIN_DSN=host=/var/run/postgresql dbname=devbrain user=postgres
DEVBRAIN_ALLOWED_ORIGINS=
DEVBRAIN_ADMIN_ALLOW=127.0.0.1/32
DEVBRAIN_ADMIN_PASSWORD_HASH=
DEVBRAIN_ACTOR_HMAC_KEY=
DEVBRAIN_CHAT_PROVIDER=openai
DEVBRAIN_CHAT_MODEL=gpt-4o-mini
DEVBRAIN_OLLAMA_URL=http://127.0.0.1:11434
DEVBRAIN_PRICES=
DEVBRAIN_SOFFICE=/usr/bin/soffice
OPENAI_API_KEY=
GEMINI_API_KEY=
# Prefer systemd credentials (CREDENTIALS_DIRECTORY) over plain env for secrets.

# Chat front-end (chat/)
CHAT_LISTEN=127.0.0.1:8093
CHAT_ORIGIN=https://chat.example.com
CHAT_USER=default
CHAT_ACTOR_EMAIL=admin@example.com
CHAT_ALLOWED_EMAILS=admin@example.com
CHAT_COMMERCIAL_QUOTES_AI=0
DEVBRAIN_URL=https://memia.internal.example
DEVBRAIN_SERVER_NAME=memia.internal.example
DEVBRAIN_CA_FILE=/etc/devbrain-chat/devbrain-ca.crt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://chat.example.com/chat/auth/google/callback
